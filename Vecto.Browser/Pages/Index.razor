@page "/"
@inject IJSRuntime Js
@implements IAsyncDisposable

<PageTitle>DikaTrace — Image to SVG</PageTitle>

<div class="app-desktop">
    <header class="site-header">
        <div class="brand">
            <span class="brand-initial" aria-hidden="true">D</span>
            <div class="brand-name"><strong>DikaTrace</strong><span>Image to SVG</span></div>
        </div>
        <div class="header-tools">
            <button type="button" class="header-reset" @onclick="ResetAsync" disabled="@(sourceBytes is null && inputUrl is null || running || loadingFile)">Bersihkan gambar</button>
        </div>
    </header>

    <main class="studio-layout">
        <section class="preview-workspace" aria-label="Pratinjau gambar">
            <div class="workspace-toolbar">
                <div class="toolbar-title">Pratinjau gambar</div>
                <div class="preview-switch" role="group" aria-label="Mode pratinjau">
                    <button type="button" class="tool-button @(previewMode == "original" ? "is-selected" : "")" @onclick="ShowOriginal" aria-pressed="@(previewMode == "original")">Asli</button>
                    <button type="button" class="tool-button @(previewMode == "vector" ? "is-selected" : "")" @onclick="ShowVector" disabled="@(svgUrl is null)" aria-pressed="@(previewMode == "vector")">SVG</button>
                    <button type="button" class="tool-button @(previewMode == "compare" ? "is-selected" : "")" @onclick="ShowCompare" disabled="@(svgUrl is null)" aria-pressed="@(previewMode == "compare")">Bandingkan</button>
                </div>
            </div>

            <div class="canvas-stage">
                @if (previewMode == "compare" && !string.IsNullOrEmpty(inputUrl) && !string.IsNullOrEmpty(svgUrl))
                {
                    <div class="compare-stage">
                        <div class="comparison-pane">
                            <div class="pane-heading">Gambar asli</div>
                            <div class="comparison-canvas"><img src="@inputUrl" alt="Gambar bitmap asli" style="@($"width:{previewZoom}%;")" /></div>
                        </div>
                        <div class="comparison-pane">
                            <div class="pane-heading">Hasil SVG</div>
                            <div class="comparison-canvas"><img src="@svgUrl" alt="Hasil DikaTrace SVG" style="@($"width:{previewZoom}%;")" /></div>
                        </div>
                    </div>
                }
                else if (previewMode == "vector" && !string.IsNullOrEmpty(svgUrl))
                {
                    <div class="single-stage"><img src="@svgUrl" alt="Hasil vektorisasi SVG" style="@($"width:{previewZoom}%;")" /></div>
                }
                else if (!string.IsNullOrEmpty(inputUrl))
                {
                    <div class="single-stage"><img src="@inputUrl" alt="Gambar yang dipilih" style="@($"width:{previewZoom}%;")" /></div>
                }
                else
                {
                    <div class="empty-preview">Belum ada gambar. Pilih file di bawah.</div>
                }
            </div>

            <div class="workspace-bottom">
                <div class="zoom-controls" role="group" aria-label="Zoom pratinjau">
                    <button type="button" @onclick="ZoomOut" disabled="@(previewZoom <= 50)" aria-label="Perkecil">−</button>
                    <button type="button" @onclick="ResetZoom" aria-label="Atur ulang zoom">@previewZoom%</button>
                    <button type="button" @onclick="ZoomIn" disabled="@(previewZoom >= 200)" aria-label="Perbesar">+</button>
                </div>
                <div class="workspace-hint">@(string.IsNullOrEmpty(inputUrl) ? "Tidak ada file" : sourceName)</div>
            </div>
        </section>

        <div class="controls-grid">
            <section class="control-panel" aria-labelledby="load-heading">
                <div class="panel-heading"><span class="step-index">1</span><h2 id="load-heading">Pilih gambar</h2></div>
                <div class="panel-body">
                    <InputFile @key="fileInputKey" OnChange="LoadFile" accept=".png,.jpg,.jpeg,.webp,.bmp" aria-label="Pilih gambar PNG JPG WebP atau BMP" />
                    <p class="help-text">PNG, JPG, WebP, BMP · Maksimum 20 MB / 8 MP<br/>Piksel dibersihkan otomatis sebelum tracing</p>
                    @if (!string.IsNullOrEmpty(inputUrl))
                    {
                        <div class="file-details"><strong>@sourceName</strong><span>@sourceSize</span></div>
                    }
                </div>
            </section>

            <section class="control-panel" aria-labelledby="settings-heading">
                <div class="panel-heading"><span class="step-index">2</span><h2 id="settings-heading">Pengaturan</h2></div>
                <div class="panel-body">
                    <div class="detected-color">
                        <span>Jumlah warna</span>
                        <strong>@(autoEstimate is { } estimate ? $"{estimate.EstimatedInkCount} (otomatis)" : "Otomatis")</strong>
                    </div>
                    <div class="setting-grid">
                        <label>Susunan bentuk
                            <select @bind="shapeMode">
                                <option value="Planar">Berdampingan</option>
                                <option value="Stacked">Bertumpuk (Stacked)</option>
                            </select>
                        </label>
                        <label>Jenis gambar
                            <select @bind="style">
                                <option value="Auto">Otomatis</option>
                                <option value="Crisp">Ilustrasi tajam</option>
                                <option value="Blended">Ilustrasi halus</option>
                                <option value="Photo">Foto</option>
                            </select>
                        </label>
                        <label>Detail
                            <select @bind="detail">
                                <option value="Low">Rendah</option>
                                <option value="Medium">Sedang</option>
                                <option value="High">Tinggi</option>
                            </select>
                        </label>
                    </div>
                    <details class="advanced-options">
                        <summary>Pengaturan lanjutan</summary>
                        <div class="advanced-inside">
                            <label>Seed <input type="number" @bind="seed" /></label>
                            <label class="check-option"><input type="checkbox" @bind="curveFitting" /> Kurva Bézier</label>
                            @if (curveFitting)
                            {
                                <label class="check-option"><input type="checkbox" @bind="optimizeNodes" /> Minimalkan titik Bézier</label>
                            }
                            @if (!curveFitting)
                            {
                                <label>Polygon epsilon <input type="number" step="0.01" @bind="polygonEpsilon" /></label>
                            }
                        </div>
                    </details>
                </div>
            </section>

            <section class="control-panel" aria-labelledby="export-heading">
                <div class="panel-heading"><span class="step-index">3</span><h2 id="export-heading">Proses &amp; unduh</h2></div>
                <div class="panel-body">
                    <button type="button" class="action-button" disabled="@(sourceBytes is null || running || loadingFile)" @onclick="TraceAsync">@(running ? "Memproses…" : "Buat SVG")</button>
                    <p class="status-line" role="status">@status</p>
                    @if (!string.IsNullOrEmpty(svgUrl))
                    {
                        <div class="result-details"><strong>Hasil: @resultSize</strong><span>@lastDiagnostics</span></div>
                        <button type="button" class="export-button" @onclick="DownloadSvg">Unduh SVG</button>
                        <button type="button" class="diagnostic-toggle" @onclick="() => showDiagnostics = !showDiagnostics">@(showDiagnostics ? "Sembunyikan" : "Lihat") hash diagnostik</button>
                        @if (showDiagnostics)
                        {
                            <div class="diagnostic-panel">
                                <div>RGBA asli <code>@originalHash</code></div>
                                <div>RGBA tracing <code>@inputHash</code></div>
                                <div>SVG FNV64 <code>@svgHash</code></div>
                            </div>
                        }
                    }
                </div>
            </section>
        </div>
    </main>
    <footer class="site-footer">DikaTrace · Proses lokal di browser</footer>
</div>

@code {
    private const long MaxUploadBytes = 20L * 1024 * 1024;
    private RasterImage? preparedRaster;
    private PixelCompressionResult? pixelCompression;
    private string originalHash = "";
    private byte[]? sourceBytes;
    private string sourceName = "image";
    private string sourceSize = "";
    private string resultSize = "";
    private string? inputUrl;
    private string? svgUrl;
    private string? svgText;
    private string status = "Pilih file gambar.";
    private string lastDiagnostics = "";
    private string inputHash = "";
    private string svgHash = "";
    private bool running;
    private bool loadingFile;
    private string previewMode = "original";
    private int previewZoom = 100;
    private bool showDiagnostics;
    private int fileInputKey;
    private ImageStyle style = ImageStyle.Auto;
    private ShapeMode shapeMode = ShapeMode.Planar;
    private DetailLevel detail = DetailLevel.Medium;
    private AutoPaletteEstimate? autoEstimate;
    private int seed = 1;
    private bool curveFitting = true;
    private bool optimizeNodes = true;
    private double polygonEpsilon = -1;

    private async Task ResetAsync()
    {
        if (running || loadingFile) return;
        sourceBytes = null;
        preparedRaster = null;
        pixelCompression = null;
        originalHash = "";
        sourceName = "image";
        sourceSize = "";
        resultSize = "";
        svgText = null;
        autoEstimate = null;
        lastDiagnostics = "";
        inputHash = "";
        svgHash = "";
        previewMode = "original";
        previewZoom = 100;
        fileInputKey++;
        await ClearUrl(true);
        await ClearUrl(false);
        status = "Pilih file gambar.";
    }

    private void ShowOriginal() => previewMode = "original";
    private void ShowVector() { if (svgUrl is not null) previewMode = "vector"; }
    private void ShowCompare() { if (svgUrl is not null) previewMode = "compare"; }
    private void ZoomIn() => previewZoom = Math.Min(200, previewZoom + 25);
    private void ZoomOut() => previewZoom = Math.Max(50, previewZoom - 25);
    private void ResetZoom() => previewZoom = 100;

    private async Task LoadFile(InputFileChangeEventArgs e)
    {
        // Keep the current image visible until the replacement blob URL is ready.
        // Decode and palette analysis run AFTER the browser paints the replacement.
        if (running || loadingFile) return;
        loadingFile = true;
        string? newUrl = null;
        string? oldUrl = inputUrl;
        bool replaced = false;
        await InvokeAsync(StateHasChanged);
        try
        {
            var file = e.File;
            if (file.Size <= 0 || file.Size > MaxUploadBytes)
                throw new InvalidDataException("Ukuran gambar harus 1 byte sampai 20 MB.");
            var ext = Path.GetExtension(file.Name).ToLowerInvariant();
            if (ext is not (".png" or ".jpg" or ".jpeg" or ".webp" or ".bmp"))
                throw new InvalidDataException("Gunakan PNG, JPG, WebP, atau BMP.");

            await using var stream = file.OpenReadStream(MaxUploadBytes);
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);
            byte[] bytes = memory.ToArray();

            string mime = ext switch
            {
                ".jpg" or ".jpeg" => "image/jpeg",
                ".webp" => "image/webp",
                ".bmp" => "image/bmp",
                _ => "image/png"
            };
            newUrl = await Js.InvokeAsync<string>("vecto.createUrl", bytes, mime);
            // Display the new file straight away, BEFORE potentially slow raster decoding.
            inputUrl = newUrl;
            replaced = true;
            previewMode = "original";
            previewZoom = 100;
            autoEstimate = null;
            sourceBytes = null;
            preparedRaster = null;
            pixelCompression = null;
            originalHash = "";
            svgText = null;
            sourceName = Path.GetFileName(file.Name);
            sourceSize = $"{file.Size / 1024.0:N0} KB";
            resultSize = "";
            lastDiagnostics = "";
            inputHash = "";
            svgHash = "";
            await ClearUrl(false);
            status = "Membaca gambar dan menghitung warna…";
            await InvokeAsync(StateHasChanged);
            await Js.InvokeVoidAsync("vecto.afterPaint");

            var raster = await RasterDecoder.DecodeAsync(bytes, Js);
            // All supported images go through quality-gated pixel preparation
            // before Auto Palette and Vecto tracing; the original preview stays.
            var prepared = PixelCompressor.Prepare(raster);
            var paletteEstimate = AutoPaletteEstimator.Analyze(prepared.Image);
            originalHash = FnvHash.Hex(raster.Pixels);
            preparedRaster = prepared.Applied ? prepared.Image : null;
            pixelCompression = prepared.Applied ? prepared : null;
            sourceBytes = bytes;
            autoEstimate = paletteEstimate;
            sourceSize = $"{raster.Width} × {raster.Height} · {file.Size / 1024.0:N0} KB";
            status = prepared.Applied
                ? $"Gambar siap. {prepared.ChangedPixels:N0} piksel dibersihkan; {paletteEstimate.EstimatedInkCount} warna terdeteksi."
                : $"Gambar siap. Piksel asli dipertahankan; {paletteEstimate.EstimatedInkCount} warna terdeteksi.";
            if (!string.IsNullOrEmpty(oldUrl))
                await Js.InvokeVoidAsync("vecto.revoke", oldUrl);
        }
        catch (Exception ex)
        {
            if (replaced)
            {
                inputUrl = oldUrl;
                if (!string.IsNullOrEmpty(newUrl))
                    await Js.InvokeVoidAsync("vecto.revoke", newUrl);
            }
            status = "Gagal membaca gambar: " + ex.Message;
        }
        finally
        {
            loadingFile = false;
        }
    }

    private async Task TraceAsync()
    {
        if (sourceBytes is null || running || loadingFile) return;
        running = true;
        status = "DikaTrace sedang membuat vektor di browser…";
        await InvokeAsync(StateHasChanged);
        await Task.Yield();
        try
        {
            // Reuse exactly the raster used by Auto Palette when cleanup is active.
            var image = preparedRaster ?? await RasterDecoder.DecodeAsync(sourceBytes, Js);
            // Palette size is always inferred from decoded pixels, not UI presets.
            int chosenMaxColors = (autoEstimate ?? AutoPaletteEstimator.Analyze(image)).RecommendedMaxColors;
            var options = new TraceOptions
            {
                Style = style,
                ShapeMode = shapeMode,
                Detail = detail,
                PaletteMode = PaletteMode.Auto,
                MaxColors = chosenMaxColors,
                Seed = seed,
                CurveFitting = curveFitting,
                OptimizeNodes = optimizeNodes,
                PolygonEpsilon = polygonEpsilon
            };
            var traced = Tracer.Trace(image, options);
            var result = SvgWriter.Write(traced.Document);
            await ClearUrl(false);
            svgText = result;
            svgUrl = await Js.InvokeAsync<string>("vecto.createUrl", System.Text.Encoding.UTF8.GetBytes(result), "image/svg+xml");
            svgHash = FnvHash.Text(result);
            previewMode = "compare";
            inputHash = FnvHash.Hex(image.Pixels);
            resultSize = $"{System.Text.Encoding.UTF8.GetByteCount(result) / 1024.0:N0} KB";
            string pixelInfo = pixelCompression is { Applied: true } c
                ? $" · pembersihan {c.ChangedPixels:N0} piksel"
                : "";
            string shapeInfo = shapeMode == ShapeMode.Stacked ? "Stacked Shapes" : "Berdampingan";
            string fitStats = traced.Diagnostics.FittedChainNodes > 0
                ? $" · Segmen Bézier {traced.Diagnostics.FittedChainNodes:N0} → {traced.Diagnostics.OptimizedChainNodes:N0}"
                : "";
            lastDiagnostics = $"{shapeInfo} · Deteksi otomatis{pixelInfo} · {traced.Diagnostics.TotalMs} ms · {traced.Diagnostics.RegionCount} regions · {traced.Diagnostics.NodeCount} nodes{fitStats} · {traced.Document.Palette.Count} colors";
            previewZoom = 100;
            status = "SVG selesai dibuat.";
        }
        catch (Exception ex)
        {
            status = "Proses gagal: " + ex.Message;
        }
        finally
        {
            running = false;
        }
    }

    private async Task DownloadSvg()
    {
        if (svgText is null || svgUrl is null) return;
        string filename = Path.GetFileNameWithoutExtension(sourceName) + ".svg";
        await Js.InvokeVoidAsync("vecto.downloadUrl", svgUrl, filename);
    }

    private async Task ClearUrl(bool input)
    {
        var url = input ? inputUrl : svgUrl;
        if (!string.IsNullOrEmpty(url))
        {
            await Js.InvokeVoidAsync("vecto.revoke", url);
            if (input) inputUrl = null; else svgUrl = null;
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await ClearUrl(true);
            await ClearUrl(false);
        }
        catch (JSDisconnectedException) { }
    }
}
