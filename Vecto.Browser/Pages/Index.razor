@page "/"
@inject IJSRuntime Js
@implements IAsyncDisposable

<PageTitle>DikaTrace — Image to SVG</PageTitle>

<div class="app-desktop">
    <header class="site-header">
        <div class="brand">
            <span class="brand-initial" aria-hidden="true">D</span>
            <div class="brand-name"><strong>DikaTrace</strong><span>Image to SVG</span></div>
        </div>
        <div class="header-tools">
            <a class="header-docs" href="docs/index.html" target="_blank" rel="noopener noreferrer" aria-label="Buka dokumentasi DikaTrace dalam tab baru">Dokumentasi <span aria-hidden="true">↗</span></a>
            <button type="button" class="header-reset" @onclick="ResetAsync" disabled="@(sourceBytes is null && inputUrl is null || running || loadingFile)">Bersihkan gambar</button>
        </div>
    </header>

    <main class="studio-layout">
        <section class="preview-workspace" aria-label="Pratinjau gambar">
            <div class="workspace-toolbar">
                <div class="toolbar-title">Pratinjau gambar</div>
                <div class="preview-switch" role="group" aria-label="Mode pratinjau">
                    <button type="button" class="tool-button @(previewMode == "original" ? "is-selected" : "")" @onclick="ShowOriginal" aria-pressed="@(previewMode == "original")">Asli</button>
                    <button type="button" class="tool-button @(previewMode == "vector" ? "is-selected" : "")" @onclick="ShowVector" disabled="@(svgUrl is null)" aria-pressed="@(previewMode == "vector")">SVG</button>
                    <button type="button" class="tool-button @(previewMode == "compare" ? "is-selected" : "")" @onclick="ShowCompare" disabled="@(svgUrl is null)" aria-pressed="@(previewMode == "compare")">Bandingkan</button>
                    <button type="button" class="tool-button @(previewMode == "ab" ? "is-selected" : "")" @onclick="ShowAb" disabled="@(alternateSvgUrl is null)" aria-pressed="@(previewMode == "ab")">A/B V3</button>
                </div>
            </div>

            <div class="canvas-stage">
                @if (previewMode == "ab" && !string.IsNullOrEmpty(alternateSvgUrl) && !string.IsNullOrEmpty(svgUrl))
                {
                    <div class="compare-stage">
                        <div class="comparison-pane">
                            <div class="pane-heading">Original Engine (V3 OFF)</div>
                            <div class="comparison-canvas"><img src="@alternateSvgUrl" alt="SVG dari engine Original" style="@($"width:{previewZoom}%;")" /></div>
                        </div>
                        <div class="comparison-pane">
                            <div class="pane-heading">Local Edge V3 (ON)</div>
                            <div class="comparison-canvas"><img src="@svgUrl" alt="SVG dari engine Local Edge V3" style="@($"width:{previewZoom}%;")" /></div>
                        </div>
                    </div>
                }
                else if (previewMode == "compare" && !string.IsNullOrEmpty(inputUrl) && !string.IsNullOrEmpty(svgUrl))
                {
                    <div class="compare-stage">
                        <div class="comparison-pane">
                            <div class="pane-heading">Gambar asli</div>
                            <div class="comparison-canvas"><img src="@inputUrl" alt="Gambar bitmap asli" style="@($"width:{previewZoom}%;")" /></div>
                        </div>
                        <div class="comparison-pane">
                            <div class="pane-heading">Hasil SVG</div>
                            <div class="comparison-canvas"><img src="@svgUrl" alt="Hasil DikaTrace SVG" style="@($"width:{previewZoom}%;")" /></div>
                        </div>
                    </div>
                }
                else if (previewMode == "vector" && !string.IsNullOrEmpty(svgUrl))
                {
                    <div class="single-stage"><img src="@svgUrl" alt="Hasil vektorisasi SVG" style="@($"width:{previewZoom}%;")" /></div>
                }
                else if (!string.IsNullOrEmpty(inputUrl))
                {
                    <div class="single-stage"><img src="@inputUrl" alt="Gambar yang dipilih" style="@($"width:{previewZoom}%;")" /></div>
                }
                else
                {
                    <div class="empty-preview">Belum ada gambar. Pilih file di bawah.</div>
                }
            </div>

            <div class="workspace-bottom">
                <div class="zoom-controls" role="group" aria-label="Zoom pratinjau">
                    <button type="button" @onclick="ZoomOut" disabled="@(previewZoom <= 50)" aria-label="Perkecil">−</button>
                    <button type="button" @onclick="ResetZoom" aria-label="Atur ulang zoom">@previewZoom%</button>
                    <button type="button" @onclick="ZoomIn" disabled="@(previewZoom >= 200)" aria-label="Perbesar">+</button>
                </div>
                <div class="workspace-hint">@(string.IsNullOrEmpty(inputUrl) ? "Tidak ada file" : sourceName)</div>
            </div>
        </section>

        <div class="controls-grid">
            <section class="control-panel" aria-labelledby="load-heading">
                <div class="panel-heading"><span class="step-index">1</span><h2 id="load-heading">Pilih gambar</h2></div>
                <div class="panel-body">
                    <InputFile @key="fileInputKey" OnChange="LoadFile" accept=".png,.jpg,.jpeg,.webp,.bmp" aria-label="Pilih gambar PNG JPG WebP atau BMP" />
                    <p class="help-text">PNG, JPG, WebP, BMP · Maksimum 20 MB / 8 MP<br/>Piksel dibersihkan otomatis sebelum tracing</p>
                    @if (!string.IsNullOrEmpty(inputUrl))
                    {
                        <div class="file-details"><strong>@sourceName</strong><span>@sourceSize</span></div>
                    }
                </div>
            </section>

            <section class="control-panel" aria-labelledby="settings-heading">
                <div class="panel-heading"><span class="step-index">2</span><h2 id="settings-heading">Pengaturan</h2></div>
                <div class="panel-body">
                    <div class="detected-color">
                        <span>Jumlah warna</span>
                        <strong>@(autoEstimate is { } estimate ? $"{estimate.EstimatedInkCount} (otomatis)" : "Otomatis")</strong>
                    </div>
                    <div class="setting-grid">
                        <label>Susunan bentuk
                            <select @bind="shapeMode">
                                <option value="Planar">Berdampingan</option>
                                <option value="Stacked">Bertumpuk (Stacked)</option>
                            </select>
                        </label>
                        <label>Jenis gambar
                            <select @bind="style">
                                <option value="Auto">Otomatis</option>
                                <option value="Crisp">Ilustrasi tajam</option>
                                <option value="Blended">Ilustrasi halus</option>
                                <option value="Photo">Foto</option>
                            </select>
                        </label>
                        <label>Detail
                            <select @bind="detail">
                                <option value="Low">Rendah</option>
                                <option value="Medium">Sedang</option>
                                <option value="High">Tinggi</option>
                            </select>
                        </label>
                    </div>
                    <div class="engine-experiment">
                        <label for="edge-engine">Engine koreksi tepi (eksperimental)</label>
                        <select id="edge-engine" @bind="engineMode" disabled="@(running || loadingFile)">
                            <option value="Original">Original — stabil</option>
                            <option value="V3">Local Edge V3 — aktifkan</option>
                            <option value="Compare">Bandingkan A/B — Original vs V3</option>
                        </select>
                        <p>Mode A/B benar-benar memproses dua SVG secara lokal dengan gambar dan pengaturan identik. V3 belum terbukti lebih baik untuk semua gambar.</p>
                    </div>
                    <details class="advanced-options">
                        <summary>Pengaturan lanjutan</summary>
                        <div class="advanced-inside">
                            <label class="check-option"><input type="checkbox" @bind="regionMergeV1" disabled="@(running || loadingFile)" /> Region Merge V1 (eksperimen, opt-in)</label>
                            <p class="help-text">Menggabungkan hanya fragmentasi kecil bila warna sumber dan batas mendukung. Ini terpisah dari Local Edge V3, tidak mengaktifkan otomatis.</p>
                            <label class="check-option"><input type="checkbox" @bind="antiAliasBandV1" disabled="@(running || loadingFile)" /> Anti-alias Aware Segmentation V1 (eksperimen)</label>
                            <p class="help-text">Mendeteksi pita warna transisi tipis yang tersisa di antara dua warna solid. Perlindungan warna asli, gradient lebar, dan transparansi; otomatis dilewati untuk input bertekstur / palet exact.</p>
                            <label class="check-option"><input type="checkbox" @bind="stackedLayerReasoningV1" disabled="@(running || loadingFile || shapeMode != ShapeMode.Stacked)" /> Stacked Layer Reasoning V1 (eksperimen)</label>
                            <p class="help-text">Khusus Bentuk Bertumpuk: menyusun layer berdasarkan hubungan tutup-menutup dan menggabungkan path sewarna. Otomatis memakai hasil Stacked biasa jika render pembanding berubah. Aktifkan Bentuk Bertumpuk terlebih dahulu.</p>
                            <label>Seed <input type="number" @bind="seed" /></label>
                            <label class="check-option"><input type="checkbox" @bind="curveFitting" /> Kurva Bézier</label>
                            @if (curveFitting)
                            {
                                <label class="check-option"><input type="checkbox" @bind="optimizeNodes" /> Minimalkan titik Bézier</label>
                            }
                            @if (!curveFitting)
                            {
                                <label>Polygon epsilon <input type="number" step="0.01" @bind="polygonEpsilon" /></label>
                            }
                        </div>
                    </details>
                </div>
            </section>

            <section class="control-panel" aria-labelledby="export-heading">
                <div class="panel-heading"><span class="step-index">3</span><h2 id="export-heading">Proses &amp; unduh</h2></div>
                <div class="panel-body">
                    <button type="button" class="action-button" disabled="@(sourceBytes is null || running || loadingFile)" @onclick="TraceAsync">@(running ? "Memproses…" : "Buat SVG")</button>
                    <p class="status-line" role="status">@status</p>
                    @if (!string.IsNullOrEmpty(svgUrl))
                    {
                        <div class="result-details"><strong>Hasil: @resultSize</strong><span>@lastDiagnostics</span></div>
                        @if (!running && !loadingFile)
                        {
                            <div class="download-links">
                                <a class="export-button" href="@svgUrl" download="@primaryDownloadName">@(alternateSvgUrl is null ? "Unduh SVG" : "Unduh Local Edge V3 SVG")</a>
                                @if (alternateSvgUrl is not null)
                                {
                                    <a class="export-button ab-secondary" href="@alternateSvgUrl" download="@alternateDownloadName">Unduh Original SVG</a>
                                }
                                <a class="download-fallback" href="@svgUrl" target="_blank" rel="noopener noreferrer">Jika tidak terunduh, buka SVG lalu simpan lewat browser</a>
                            </div>
                        }
                        @if (alternateSvgUrl is not null && baselineDiagnostics is not null && v3Diagnostics is not null)
                        {
                            <div class="ab-report">
                                <strong>Hasil A/B — parameter sama</strong>
                                <div class="ab-table-scroll">
                                    <table>
                                        <thead><tr><th>Metrik</th><th>Original</th><th>Local V3</th></tr></thead>
                                        <tbody>
                                            <tr><td>Waktu tracing</td><td>@baselineDiagnostics.TotalMs ms</td><td>@v3Diagnostics.TotalMs ms</td></tr>
                                            <tr><td>Region</td><td>@baselineDiagnostics.RegionCount</td><td>@v3Diagnostics.RegionCount</td></tr>
                                            <tr><td>Node geometri</td><td>@baselineDiagnostics.NodeCount</td><td>@v3Diagnostics.NodeCount</td></tr>
                                            <tr><td>Node setelah optimasi</td><td>@baselineDiagnostics.OptimizedChainNodes</td><td>@v3Diagnostics.OptimizedChainNodes</td></tr>
                                            <tr><td>Segmen SVG</td><td>@originalSegments</td><td>@v3Segments</td></tr>
                                            <tr><td>Garis mikro (&lt;2 px)</td><td>@originalMicroLines</td><td>@v3MicroLines</td></tr>
                                            <tr><td>Ukuran SVG</td><td>@originalSvgBytes B</td><td>@v3SvgBytes B</td></tr>
                                            <tr><td>Titik digeser V3</td><td>0</td><td>@v3Diagnostics.LocalEdgeV3MovedPoints</td></tr>
                                            @if (pixelAudit is not null)
                                            {
                                                <tr><td>IoU mask</td><td>@($"{pixelAudit.Original.Iou * 100:F3}%")</td><td>@($"{pixelAudit.V3.Iou * 100:F3}%")</td></tr>
                                                <tr><td>SSIM luminans 8×8</td><td>@($"{pixelAudit.Original.Ssim:F5}")</td><td>@($"{pixelAudit.V3.Ssim:F5}")</td></tr>
                                                <tr><td>Kesalahan mask (px)</td><td>@pixelAudit.Original.Wrong</td><td>@pixelAudit.V3.Wrong</td></tr>
                                                <tr><td>MAE RGB</td><td>@($"{pixelAudit.Original.Mae:F2}")</td><td>@($"{pixelAudit.V3.Mae:F2}")</td></tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                                @if (pixelAudit is not null)
                                {
                                    <p>Metrik raster: @pixelAudit.Width × @pixelAudit.Height px (maksimum sisi 1024 px), komposit putih. IoU/kesalahan mask menggunakan luminans &lt;128 dan terutama relevan untuk gambar dua warna; SSIM memakai jendela non-overlap 8×8, bukan skimage. Bandingkan juga MAE RGB untuk ilustrasi berwarna.</p>
                                }
                                else if (!string.IsNullOrEmpty(pixelAuditError))
                                {
                                    <p>Metrik raster tidak tersedia: @pixelAuditError. Dua SVG tetap bisa diperiksa dan diunduh.</p>
                                }
                                @if (string.Equals(alternateSvgText, svgText, StringComparison.Ordinal))
                                {
                                    <p class="ab-warning">Kedua SVG identik. V3 tidak menghasilkan perubahan yang terlihat pada gambar ini.</p>
                                }
                                else
                                {
                                    <p class="ab-different">Kedua SVG berbeda. Periksa bentuk tepi, ujung tajam, dan ukuran sebelum memutuskan V3 lebih baik.</p>
                                }
                            </div>
                        }
                        @if (primaryStatistics is not null && primaryDiagnostics is not null && primaryTraceOptions is not null)
                        {
                            <SvgMetadataPanel Stats="@primaryStatistics" Diagnostics="@primaryDiagnostics"
                                Options="@primaryTraceOptions" Filename="@primaryDownloadName" EngineLabel="@primaryEngineName"
                                SvgHash="@svgHash" SourceFileBytes="@(sourceBytes?.LongLength ?? 0L)"
                                CleanupApplied="@(pixelCompression?.Applied ?? false)"
                                CleanedPixels="@(pixelCompression?.ChangedPixels ?? 0)" Expanded="true" />
                        }
                        @if (alternateStatistics is not null && baselineDiagnostics is not null && alternateTraceOptions is not null)
                        {
                            <SvgMetadataPanel Stats="@alternateStatistics" Diagnostics="@baselineDiagnostics"
                                Options="@alternateTraceOptions" Filename="@alternateDownloadName" EngineLabel="Original (A/B)"
                                SvgHash="@alternateSvgHash" SourceFileBytes="@(sourceBytes?.LongLength ?? 0L)"
                                CleanupApplied="@(pixelCompression?.Applied ?? false)"
                                CleanedPixels="@(pixelCompression?.ChangedPixels ?? 0)" Expanded="false" />
                        }
                        <button type="button" class="diagnostic-toggle" @onclick="() => showDiagnostics = !showDiagnostics">@(showDiagnostics ? "Sembunyikan" : "Lihat") hash diagnostik</button>
                        @if (showDiagnostics)
                        {
                            <div class="diagnostic-panel">
                                <div>RGBA asli <code>@originalHash</code></div>
                                <div>RGBA tracing <code>@inputHash</code></div>
                                <div>SVG FNV64 <code>@svgHash</code></div>
                            </div>
                        }
                    }
                </div>
            </section>
        </div>
    </main>
    <footer class="site-footer">DikaTrace · Proses lokal di browser</footer>
</div>

@code {
    private const long MaxUploadBytes = 20L * 1024 * 1024;
    private RasterImage? preparedRaster;
    private PixelCompressionResult? pixelCompression;
    private string originalHash = "";
    private byte[]? sourceBytes;
    private string sourceName = "image";
    private string sourceSize = "";
    private string resultSize = "";
    private string? inputUrl;
    private string? svgUrl;
    private string? svgText;
    // In A/B mode the primary SVG is V3, the alternate SVG is the untouched Original.
    private string? alternateSvgText;
    private string? alternateSvgUrl;
    private SvgOutputStatistics? primaryStatistics;
    private SvgOutputStatistics? alternateStatistics;
    private TraceDiagnostics? primaryDiagnostics;
    private TraceOptions? primaryTraceOptions;
    private TraceOptions? alternateTraceOptions;
    private string primaryDownloadName = "dikatrace.svg";
    private string alternateDownloadName = "dikatrace-original.svg";
    private string primaryEngineName = "Original";
    private string alternateSvgHash = "";
    private TraceDiagnostics? baselineDiagnostics;
    private TraceDiagnostics? v3Diagnostics;
    private PixelAbAudit? pixelAudit;
    private string pixelAuditError = "";
    private int originalSegments, v3Segments, originalMicroLines, v3MicroLines;
    private int originalSvgBytes, v3SvgBytes;
    private string engineMode = "Original";
    private string status = "Pilih file gambar.";
    private string lastDiagnostics = "";
    private string inputHash = "";
    private string svgHash = "";
    private bool running;
    private bool loadingFile;
    private string previewMode = "original";
    private int previewZoom = 100;
    private bool showDiagnostics;
    private int fileInputKey;
    private ImageStyle style = ImageStyle.Auto;
    private ShapeMode shapeMode = ShapeMode.Planar;
    private DetailLevel detail = DetailLevel.Medium;
    private AutoPaletteEstimate? autoEstimate;
    private int seed = 1;
    private bool regionMergeV1;
    private bool antiAliasBandV1;
    private bool stackedLayerReasoningV1;
    private bool curveFitting = true;
    private bool optimizeNodes = true;
    private double polygonEpsilon = -1;

    private async Task ResetAsync()
    {
        if (running || loadingFile) return;
        sourceBytes = null;
        preparedRaster = null;
        pixelCompression = null;
        originalHash = "";
        sourceName = "image";
        sourceSize = "";
        resultSize = "";
        svgText = null;
        ResetAbStats();
        autoEstimate = null;
        lastDiagnostics = "";
        inputHash = "";
        svgHash = "";
        previewMode = "original";
        previewZoom = 100;
        fileInputKey++;
        await ClearUrl(true);
        await ClearUrl(false);
        await ClearAlternateUrl();
        status = "Pilih file gambar.";
    }

    private void ShowOriginal() => previewMode = "original";
    private void ShowVector() { if (svgUrl is not null) previewMode = "vector"; }
    private void ShowCompare() { if (svgUrl is not null) previewMode = "compare"; }
    private void ShowAb() { if (alternateSvgUrl is not null) previewMode = "ab"; }
    private void ZoomIn() => previewZoom = Math.Min(200, previewZoom + 25);
    private void ZoomOut() => previewZoom = Math.Max(50, previewZoom - 25);
    private void ResetZoom() => previewZoom = 100;

    private async Task LoadFile(InputFileChangeEventArgs e)
    {
        // Keep the current image visible until the replacement blob URL is ready.
        // Decode and palette analysis run AFTER the browser paints the replacement.
        if (running || loadingFile) return;
        loadingFile = true;
        string? newUrl = null;
        string? oldUrl = inputUrl;
        bool replaced = false;
        await InvokeAsync(StateHasChanged);
        try
        {
            var file = e.File;
            if (file.Size <= 0 || file.Size > MaxUploadBytes)
                throw new InvalidDataException("Ukuran gambar harus 1 byte sampai 20 MB.");
            var ext = Path.GetExtension(file.Name).ToLowerInvariant();
            if (ext is not (".png" or ".jpg" or ".jpeg" or ".webp" or ".bmp"))
                throw new InvalidDataException("Gunakan PNG, JPG, WebP, atau BMP.");

            await using var stream = file.OpenReadStream(MaxUploadBytes);
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);
            byte[] bytes = memory.ToArray();

            string mime = ext switch
            {
                ".jpg" or ".jpeg" => "image/jpeg",
                ".webp" => "image/webp",
                ".bmp" => "image/bmp",
                _ => "image/png"
            };
            newUrl = await Js.InvokeAsync<string>("vecto.createUrl", bytes, mime);
            // Display the new file straight away, BEFORE potentially slow raster decoding.
            inputUrl = newUrl;
            replaced = true;
            previewMode = "original";
            previewZoom = 100;
            autoEstimate = null;
            sourceBytes = null;
            preparedRaster = null;
            pixelCompression = null;
            originalHash = "";
            svgText = null;
            ResetAbStats();
            sourceName = Path.GetFileName(file.Name);
            sourceSize = $"{file.Size / 1024.0:N0} KB";
            resultSize = "";
            lastDiagnostics = "";
            inputHash = "";
            svgHash = "";
            await ClearUrl(false);
            await ClearAlternateUrl();
            status = "Membaca gambar dan menghitung warna…";
            await InvokeAsync(StateHasChanged);
            await Js.InvokeVoidAsync("vecto.afterPaint");

            var raster = await RasterDecoder.DecodeAsync(bytes, Js);
            // All supported images go through quality-gated pixel preparation
            // before Auto Palette and Vecto tracing; the original preview stays.
            var prepared = PixelCompressor.Prepare(raster);
            var paletteEstimate = AutoPaletteEstimator.Analyze(prepared.Image);
            originalHash = FnvHash.Hex(raster.Pixels);
            preparedRaster = prepared.Applied ? prepared.Image : null;
            pixelCompression = prepared.Applied ? prepared : null;
            sourceBytes = bytes;
            autoEstimate = paletteEstimate;
            sourceSize = $"{raster.Width} × {raster.Height} · {file.Size / 1024.0:N0} KB";
            status = prepared.Applied
                ? $"Gambar siap. {prepared.ChangedPixels:N0} piksel dibersihkan; {paletteEstimate.EstimatedInkCount} warna terdeteksi."
                : $"Gambar siap. Piksel asli dipertahankan; {paletteEstimate.EstimatedInkCount} warna terdeteksi.";
            if (!string.IsNullOrEmpty(oldUrl))
                await Js.InvokeVoidAsync("vecto.revoke", oldUrl);
        }
        catch (Exception ex)
        {
            if (replaced)
            {
                inputUrl = oldUrl;
                if (!string.IsNullOrEmpty(newUrl))
                    await Js.InvokeVoidAsync("vecto.revoke", newUrl);
            }
            status = "Gagal membaca gambar: " + ex.Message;
        }
        finally
        {
            loadingFile = false;
        }
    }

    private TraceOptions BuildOptions(int colors, bool enableV3) => new()
    {
        Style = style,
        ShapeMode = shapeMode,
        Detail = detail,
        PaletteMode = PaletteMode.Auto,
        MaxColors = colors,
        Seed = seed,
        CurveFitting = curveFitting,
        OptimizeNodes = optimizeNodes,
        PolygonEpsilon = polygonEpsilon,
        EdgeCoverageThreshold = 0.5,
        LocalEdgeRefinementV3 = enableV3,
        RegionMergeV1 = regionMergeV1,
        AntiAliasBandV1 = antiAliasBandV1,
        StackedLayerReasoningV1 = stackedLayerReasoningV1 && shapeMode == ShapeMode.Stacked
    };

    private static int CountSegments(TraceResult trace) =>
        trace.Document.Regions.Sum(r => r.Loops.Sum(loop => loop.Count));

    private static int CountMicroLines(TraceResult trace) =>
        trace.Document.Regions.Sum(r => r.Loops.Sum(loop =>
            loop.Count(segment => segment.IsLine() && (segment.P3 - segment.P0).Length < 2)));

    private void ResetAbStats()
    {
        primaryStatistics = null;
        alternateStatistics = null;
        primaryDiagnostics = null;
        primaryTraceOptions = null;
        alternateTraceOptions = null;
        primaryDownloadName = "dikatrace.svg";
        alternateDownloadName = "dikatrace-original.svg";
        primaryEngineName = "Original";
        alternateSvgHash = "";
        alternateSvgText = null;
        baselineDiagnostics = null;
        v3Diagnostics = null;
        pixelAudit = null;
        pixelAuditError = "";
        originalSegments = v3Segments = originalMicroLines = v3MicroLines = 0;
        originalSvgBytes = v3SvgBytes = 0;
    }

    private async Task TraceAsync()
    {
        if (sourceBytes is null || running || loadingFile) return;
        running = true;
        status = "DikaTrace sedang membuat vektor di browser…";
        await InvokeAsync(StateHasChanged);
        await Task.Yield();
        try
        {
            // A/B must share the SAME prepared image, auto palette estimate and every other option.
            var image = preparedRaster ?? await RasterDecoder.DecodeAsync(sourceBytes, Js);
            int colors = (autoEstimate ?? AutoPaletteEstimator.Analyze(image)).RecommendedMaxColors;
            bool compare = engineMode == "Compare";
            bool useV3 = engineMode != "Original";
            TraceResult? originalTrace = null;
            string? originalSvg = null;
            TraceOptions? originalOptions = null;
            if (compare)
            {
                originalOptions = BuildOptions(colors, false);
                originalTrace = Tracer.Trace(image, originalOptions);
                originalSvg = SvgWriter.Write(originalTrace.Document);
            }

            var traceOptions = BuildOptions(colors, useV3);
            var traced = Tracer.Trace(image, traceOptions);
            string result = SvgWriter.Write(traced.Document);

            // Do not revoke old preview URLs until replacement SVGs exist.
            await ClearUrl(false);
            await ClearAlternateUrl();
            ResetAbStats();
            primaryStatistics = SvgOutputStatistics.Analyze(traced.Document, result);
            primaryDiagnostics = traced.Diagnostics;
            primaryTraceOptions = traceOptions;
            primaryEngineName = useV3 ? "Local Edge V3" : "Original";
            primaryDownloadName = MakeSvgDownloadName(sourceName, useV3 ? "-local-edge-v3" : "");
            svgText = result;
            svgUrl = await Js.InvokeAsync<string>("vecto.createUrl",
                System.Text.Encoding.UTF8.GetBytes(result), "image/svg+xml");
            svgHash = FnvHash.Text(result);
            previewMode = compare ? "ab" : "compare";
            inputHash = FnvHash.Hex(image.Pixels);
            resultSize = $"{System.Text.Encoding.UTF8.GetByteCount(result) / 1024.0:N0} KB";
            string pixelInfo = pixelCompression is { Applied: true } c
                ? $" · pembersihan {c.ChangedPixels:N0} piksel"
                : "";
            string shapeInfo = shapeMode == ShapeMode.Stacked ? "Stacked Shapes" : "Berdampingan";
            string fitStats = traced.Diagnostics.FittedChainNodes > 0
                ? $" · Segmen Bézier {traced.Diagnostics.FittedChainNodes:N0} → {traced.Diagnostics.OptimizedChainNodes:N0}"
                : "";
            if (traced.Diagnostics.GlobalReducedChains > 0)
                fitStats += $" · DP global unggul di {traced.Diagnostics.GlobalReducedChains:N0} rantai";
            string mergeInfo = traceOptions.RegionMergeV1
                ? $" · Region Merge V1: -{traced.Diagnostics.RegionMergeV1MergedRegions:N0} region / {traced.Diagnostics.RegionMergeV1ChangedPixels:N0} piksel"
                : "";
            string aaInfo = traceOptions.AntiAliasBandV1
                ? traced.Diagnostics.AntiAliasBandsSkipped
                    ? " · Anti-alias Band V1: dilewati (exact/textured)"
                    : traced.Diagnostics.AntiAliasBands.RolledBack
                        ? " · Anti-alias Band V1: rollback (topologi)"
                        : $" · Anti-alias Band V1: -{traced.Diagnostics.AntiAliasBands.BandsReassigned:N0} pita / {traced.Diagnostics.AntiAliasBands.PixelsReassigned:N0} piksel"
                : "";
            string stackedInfo = traceOptions.StackedLayerReasoningV1
                ? traced.Diagnostics.StackedLayers.Reverted
                    ? $" · Stacked Layer V1: fallback (selisih {traced.Diagnostics.StackedLayers.PixelMismatches:N0} piksel)"
                    : $" · Stacked Layer V1: -{traced.Diagnostics.StackedLayers.PathsSaved:N0} path / {traced.Diagnostics.StackedLayers.ComparedPixels:N0} piksel diverifikasi"
                : "";
            string v3Info = useV3
                ? $" · Local Edge V3: {traced.Diagnostics.LocalEdgeV3MovedPoints:N0} titik digeser"
                : " · Engine Original";
            lastDiagnostics = $"{shapeInfo} · Deteksi otomatis{pixelInfo} · {traced.Diagnostics.TotalMs} ms · {traced.Diagnostics.RegionCount} regions · {traced.Diagnostics.NodeCount} nodes{fitStats} · {traced.Document.Palette.Count} colors{v3Info}{mergeInfo}{aaInfo}{stackedInfo}";

            if (compare && originalTrace is not null && originalSvg is not null && originalOptions is not null)
            {
                alternateStatistics = SvgOutputStatistics.Analyze(originalTrace.Document, originalSvg);
                alternateTraceOptions = originalOptions;
                alternateDownloadName = MakeSvgDownloadName(sourceName, "-original");
                alternateSvgHash = FnvHash.Text(originalSvg);
                alternateSvgText = originalSvg;
                alternateSvgUrl = await Js.InvokeAsync<string>("vecto.createUrl",
                    System.Text.Encoding.UTF8.GetBytes(originalSvg), "image/svg+xml");
                baselineDiagnostics = originalTrace.Diagnostics;
                v3Diagnostics = traced.Diagnostics;
                originalSegments = CountSegments(originalTrace);
                v3Segments = CountSegments(traced);
                originalMicroLines = CountMicroLines(originalTrace);
                v3MicroLines = CountMicroLines(traced);
                originalSvgBytes = System.Text.Encoding.UTF8.GetByteCount(originalSvg);
                v3SvgBytes = System.Text.Encoding.UTF8.GetByteCount(result);

                try
                {
                    if (inputUrl is not null && svgUrl is not null && alternateSvgUrl is not null)
                        pixelAudit = await Js.InvokeAsync<PixelAbAudit>(
                            "vecto.measureSvgPair", inputUrl, alternateSvgUrl, svgUrl);
                }
                catch (Exception ex)
                {
                    // Raster metrics must never prevent download/inspection of actual SVG results.
                    pixelAuditError = ex.Message;
                }
            }

            previewZoom = 100;
            status = compare
                ? "A/B selesai. Kedua SVG dibuat dengan setting identik; lihat tabel dan pratinjau A/B V3."
                : useV3
                    ? $"Local Edge V3 selesai: {traced.Diagnostics.LocalEdgeV3MovedPoints:N0} titik digeser."
                    : "SVG Original selesai dibuat.";
        }
        catch (Exception ex)
        {
            status = "Proses gagal: " + ex.Message;
        }
        finally
        {
            running = false;
        }
    }

    public sealed class PixelAbRow
    {
        public double Iou { get; set; }
        public double Ssim { get; set; }
        public int Wrong { get; set; }
        public double Mae { get; set; }
    }

    public sealed class PixelAbAudit
    {
        public int Width { get; set; }
        public int Height { get; set; }
        public PixelAbRow Original { get; set; } = new();
        public PixelAbRow V3 { get; set; } = new();
    }

    // Snapshot the file name at trace time. Changing the engine selector later
    // must never rename or misidentify an already-rendered result.
    private static string MakeSvgDownloadName(string uploadedName, string suffix)
    {
        string stem = Path.GetFileNameWithoutExtension(uploadedName);
        string invalid = "/\\:*?\"<>|";
        stem = new string(stem.Select(c => char.IsControl(c) || invalid.Contains(c) ? '_' : c).ToArray()).Trim().Trim('.');
        if (string.IsNullOrWhiteSpace(stem)) stem = "dikatrace";
        if (stem.Length > 100) stem = stem[..100];
        return stem + suffix + ".svg";
    }

    private async Task ClearAlternateUrl()
    {
        if (!string.IsNullOrEmpty(alternateSvgUrl))
        {
            await Js.InvokeVoidAsync("vecto.revoke", alternateSvgUrl);
            alternateSvgUrl = null;
        }
    }

    private async Task ClearUrl(bool input)
    {
        var url = input ? inputUrl : svgUrl;
        if (!string.IsNullOrEmpty(url))
        {
            await Js.InvokeVoidAsync("vecto.revoke", url);
            if (input) inputUrl = null; else svgUrl = null;
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await ClearUrl(true);
            await ClearUrl(false);
            await ClearAlternateUrl();
        }
        catch (JSDisconnectedException) { }
    }
}
