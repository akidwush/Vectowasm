@page "/"
@inject IJSRuntime Js
@implements IAsyncDisposable

<PageTitle>DikaTrace • Desktop Vector Studio</PageTitle>

<div class="app-desktop">
    <header class="window-titlebar">
        <div class="brand-icon" aria-hidden="true">D</div>
        <div class="window-heading"><strong>DikaTrace</strong><span>Raster to Vector Studio</span></div>
        <div class="window-indicator"><span class="indicator-dot"></span> Browser Edition</div>
        <div class="window-buttons" aria-hidden="true"><span>─</span><span>□</span><span>×</span></div>
    </header>

    <div class="menubar">
        <span class="menubar-active">DikaTrace</span>
        <span>Image Conversion</span>
        <span class="menubar-right">C# • WebAssembly • Local processing</span>
    </div>

    <main class="studio-layout">
        <section class="preview-workspace" aria-label="Workspace gambar">
            <div class="workspace-toolbar">
                <div class="toolbar-title"><span class="toolbar-symbol">▧</span> Image Preview <button type="button" class="new-image-button" @onclick="ResetAsync" disabled="@(sourceBytes is null || running)">New Image</button></div>
                <div class="preview-switch" role="group" aria-label="Mode pratinjau">
                    <button type="button" class="tool-button @(previewMode == "original" ? "is-selected" : "")" @onclick="ShowOriginal">Bitmap</button>
                    <button type="button" class="tool-button @(previewMode == "vector" ? "is-selected" : "")" @onclick="ShowVector" disabled="@(svgUrl is null)">Vector</button>
                    <button type="button" class="tool-button @(previewMode == "compare" ? "is-selected" : "")" @onclick="ShowCompare" disabled="@(svgUrl is null)">Compare</button>
                </div>
            </div>

            <div class="canvas-stage">
                @if (previewMode == "compare" && !string.IsNullOrEmpty(inputUrl) && !string.IsNullOrEmpty(svgUrl))
                {
                    <div class="compare-stage">
                        <div class="comparison-pane">
                            <div class="pane-heading"><span>Original Bitmap</span><small>RASTER</small></div>
                            <div class="comparison-canvas"><img src="@inputUrl" alt="Gambar bitmap asli" style="@($"width:{previewZoom}%;")" /></div>
                        </div>
                        <div class="comparison-pane">
                            <div class="pane-heading"><span>Vectorized Result</span><small>SVG</small></div>
                            <div class="comparison-canvas"><img src="@svgUrl" alt="Hasil DikaTrace SVG" style="@($"width:{previewZoom}%;")" /></div>
                        </div>
                    </div>
                }
                else if (previewMode == "vector" && !string.IsNullOrEmpty(svgUrl))
                {
                    <div class="single-stage">
                        <img src="@svgUrl" alt="Hasil vektorisasi SVG" style="@($"width:{previewZoom}%;")" />
                    </div>
                }
                else if (!string.IsNullOrEmpty(inputUrl))
                {
                    <div class="single-stage">
                        <img src="@inputUrl" alt="Gambar input asli" style="@($"width:{previewZoom}%;")" />
                    </div>
                }
                else
                {
                    <div class="welcome-empty">
                        <div class="empty-graphic" aria-hidden="true"><span class="empty-circle"></span><span class="empty-corner"></span></div>
                        <strong>Welcome to DikaTrace</strong>
                        <p>Load an image to start vectorizing.</p>
                        <small>PNG · JPG · WEBP · BMP</small>
                    </div>
                }
            </div>

            <div class="workspace-bottom">
                <div class="zoom-controls" role="group" aria-label="Perbesar pratinjau">
                    <button type="button" @onclick="ZoomOut" disabled="@(previewZoom <= 50)" title="Zoom out">−</button>
                    <button type="button" @onclick="ResetZoom" title="Reset zoom">@previewZoom%</button>
                    <button type="button" @onclick="ZoomIn" disabled="@(previewZoom >= 200)" title="Zoom in">+</button>
                </div>
                <div class="workspace-hint">
                    @(sourceBytes is null ? "No image loaded" : sourceName)
                </div>
            </div>
        </section>

        <aside class="wizard-panel" aria-label="DikaTrace wizard">
            <div class="wizard-heading">
                <span>Vectorization Wizard</span>
                <span class="wizard-subtitle">Classic Mode</span>
            </div>

            <section class="wizard-step">
                <div class="step-title"><span class="step-index">1</span><strong>Load Image</strong><span class="step-status @(sourceBytes is not null ? "done" : "")">@(sourceBytes is not null ? "Done" : "Step 1")</span></div>
                <div class="step-body">
                    <div class="input-dropzone">
                        <div class="file-icon" aria-hidden="true">▧</div>
                        <div class="upload-label"><strong>Select Bitmap Image</strong><span>PNG, JPG, WEBP or BMP</span></div>
                        <InputFile @key="fileInputKey" OnChange="LoadFile" accept=".png,.jpg,.jpeg,.webp,.bmp" aria-label="Choose image to vectorize" />
                    </div>
                    @if (!string.IsNullOrWhiteSpace(sourceSize) && sourceBytes is not null)
                    {
                        <div class="file-details"><strong>@sourceName</strong><span>@sourceSize</span></div>
                    }
                    <p class="help-text">Up to 20 MB / 8 megapixels. Your file stays on this device.</p>
                </div>
            </section>

            <section class="wizard-step">
                <div class="step-title"><span class="step-index">2</span><strong>Vectorization Settings</strong><span class="step-status @(autoEstimate is not null ? "done" : "")">Automatic</span></div>
                <div class="step-body">
                    <div class="option-card selected-option">
                        <span class="option-mark">✓</span>
                        <div><strong>Automatic Color Detection</strong><p>DikaTrace finds the useful colors directly from your image.</p></div>
                    </div>
                    @if (autoEstimate is { } estimate)
                    {
                        <div class="detected-color"><span>Detected primary colors</span><strong>@estimate.EstimatedInkCount</strong></div>
                    }
                    <div class="setting-grid">
                        <label>Image Type
                            <select @bind="style">
                                <option value="Auto">Automatic</option>
                                <option value="Crisp">Sharp Artwork</option>
                                <option value="Blended">Smooth Artwork</option>
                                <option value="Photo">Photograph</option>
                            </select>
                        </label>
                        <label>Detail Level
                            <select @bind="detail">
                                <option value="Low">Low</option>
                                <option value="Medium">Medium</option>
                                <option value="High">High</option>
                            </select>
                        </label>
                    </div>
                    <details class="advanced-options">
                        <summary>Advanced Settings</summary>
                        <div class="advanced-inside">
                            <label>Random Seed <input type="number" @bind="seed" /></label>
                            <label class="check-option"><input type="checkbox" @bind="curveFitting" /> Smooth Bézier Curves</label>
                            @if (!curveFitting)
                            {
                                <label>Polygon Epsilon <input type="number" step="0.01" @bind="polygonEpsilon" /></label>
                            }
                        </div>
                    </details>
                </div>
            </section>

            <section class="wizard-step wizard-last">
                <div class="step-title"><span class="step-index">3</span><strong>Trace & Export</strong><span class="step-status @(svgUrl is not null ? "done" : "")">@(svgUrl is not null ? "Ready" : "Step 3")</span></div>
                <div class="step-body">
                    <button type="button" class="action-button" disabled="@(sourceBytes is null || running)" @onclick="TraceAsync">
                        <span aria-hidden="true">▶</span> @(running ? "Vectorizing…" : "Vectorize Image")
                    </button>
                    <div class="status-line" role="status">@status</div>
                    @if (!string.IsNullOrEmpty(svgUrl))
                    {
                        <div class="result-details"><strong>SVG Output Ready</strong><span>@resultSize · @lastDiagnostics</span></div>
                        <button type="button" class="export-button" @onclick="DownloadSvg"><span aria-hidden="true">↓</span> Save SVG File</button>
                        <button type="button" class="diagnostic-toggle" @onclick="() => showDiagnostics = !showDiagnostics">@(showDiagnostics ? "Hide" : "Show") diagnostics</button>
                        @if (showDiagnostics)
                        {
                            <div class="diagnostic-panel">
                                <div>RGBA FNV64 <code>@inputHash</code></div>
                                <div>SVG FNV64 <code>@svgHash</code></div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="help-text">Choose an image, adjust settings, then vectorize to preview and export your SVG.</p>
                    }
                </div>
            </section>
            <div class="wizard-footer"><span class="footer-led"></span> Processing is local · No uploads</div>
        </aside>
    </main>

    <footer class="desktop-statusbar">
        <span><strong>DikaTrace</strong> · Ready for precision vectorization</span>
        <span class="status-version">Desktop-inspired interface · C# WASM</span>
    </footer>
</div>

@code {
    private const long MaxUploadBytes = 20L * 1024 * 1024;
    private byte[]? sourceBytes;
    private string sourceName = "image";
    private string sourceSize = "";
    private string resultSize = "";
    private string? inputUrl;
    private string? svgUrl;
    private string? svgText;
    private string status = "Pilih file gambar untuk mulai.";
    private string lastDiagnostics = "";
    private string inputHash = "";
    private string svgHash = "";
    private bool running;
    private string previewMode = "original";
    private int previewZoom = 100;
    private bool showDiagnostics;
    private int fileInputKey;
    private ImageStyle style = ImageStyle.Auto;
    private DetailLevel detail = DetailLevel.Medium;
    private AutoPaletteEstimate? autoEstimate;
    private int seed = 1;
    private bool curveFitting = true;
    private double polygonEpsilon = -1;

    private async Task ResetAsync()
    {
        if (running) return;
        sourceBytes = null;
        sourceName = "image";
        sourceSize = "";
        resultSize = "";
        svgText = null;
        autoEstimate = null;
        lastDiagnostics = "";
        inputHash = "";
        svgHash = "";
        previewMode = "original";
        previewZoom = 100;
        fileInputKey++;
        await ClearUrl(true);
        await ClearUrl(false);
        status = "Pilih gambar untuk memulai.";
    }

    private void ShowOriginal() => previewMode = "original";
    private void ShowVector() { if (svgUrl is not null) previewMode = "vector"; }
    private void ShowCompare() { if (svgUrl is not null) previewMode = "compare"; }
    private void ZoomIn() => previewZoom = Math.Min(200, previewZoom + 25);
    private void ZoomOut() => previewZoom = Math.Max(50, previewZoom - 25);
    private void ResetZoom() => previewZoom = 100;

    private async Task LoadFile(InputFileChangeEventArgs e)
    {
        try
        {
            sourceBytes = null;
            autoEstimate = null;
            previewMode = "original";
            previewZoom = 100;
            svgText = null;

            await ClearUrl(true);
            await ClearUrl(false);
            var file = e.File;
            if (file.Size <= 0 || file.Size > MaxUploadBytes)
                throw new InvalidDataException("Ukuran file harus 1 byte sampai 20 MB.");
            var ext = Path.GetExtension(file.Name).ToLowerInvariant();
            if (ext is not (".png" or ".jpg" or ".jpeg" or ".webp" or ".bmp"))
                throw new InvalidDataException("Hanya PNG, JPEG, WebP, BMP yang didukung.");
            await using var stream = file.OpenReadStream(MaxUploadBytes);
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);
            var bytes = memory.ToArray();
            var raster = await RasterDecoder.DecodeAsync(bytes, Js);
            var paletteEstimate = AutoPaletteEstimator.Analyze(raster);
            autoEstimate = paletteEstimate;
            sourceBytes = bytes;
            sourceName = Path.GetFileName(file.Name);
            sourceSize = $"{raster.Width} × {raster.Height} · {file.Size / 1024.0:N0} KB";
            string mime = ext switch
            {
                ".jpg" or ".jpeg" => "image/jpeg",
                ".webp" => "image/webp",
                ".bmp" => "image/bmp",
                _ => "image/png"
            };
            inputUrl = await Js.InvokeAsync<string>("vecto.createUrl", bytes, mime);
            status = $"Gambar siap. DikaTrace mendeteksi {paletteEstimate.EstimatedInkCount} warna utama. Klik Vectorize Image.";
        }
        catch (Exception ex)
        {
            sourceBytes = null;
            autoEstimate = null;
            status = "Gagal membuka gambar: " + ex.Message;
        }
    }

    private async Task TraceAsync()
    {
        if (sourceBytes is null || running) return;
        running = true;
        status = "DikaTrace sedang membuat vektor di browser…";
        await InvokeAsync(StateHasChanged);
        await Task.Yield();
        try
        {
            var image = await RasterDecoder.DecodeAsync(sourceBytes, Js);
            // Palette size is always inferred from decoded pixels, not UI presets.
            int chosenMaxColors = (autoEstimate ?? AutoPaletteEstimator.Analyze(image)).RecommendedMaxColors;
            var options = new TraceOptions
            {
                Style = style,
                Detail = detail,
                PaletteMode = PaletteMode.Auto,
                MaxColors = chosenMaxColors,
                Seed = seed,
                CurveFitting = curveFitting,
                PolygonEpsilon = polygonEpsilon
            };
            var traced = Tracer.Trace(image, options);
            var result = SvgWriter.Write(traced.Document);
            await ClearUrl(false);
            svgText = result;
            svgUrl = await Js.InvokeAsync<string>("vecto.createUrl", System.Text.Encoding.UTF8.GetBytes(result), "image/svg+xml");
            svgHash = FnvHash.Text(result);
            previewMode = "compare";
            inputHash = FnvHash.Hex(image.Pixels);
            resultSize = $"{System.Text.Encoding.UTF8.GetByteCount(result) / 1024.0:N0} KB";
            lastDiagnostics = $"Deteksi otomatis · {traced.Diagnostics.TotalMs} ms · {traced.Diagnostics.RegionCount} regions · {traced.Diagnostics.NodeCount} nodes · {traced.Document.Palette.Count} colors";
            previewZoom = 100;
            status = "Selesai! Bandingkan Bitmap dan Vector, lalu simpan SVG.";
        }
        catch (Exception ex)
        {
            status = "Proses gagal: " + ex.Message;
        }
        finally
        {
            running = false;
        }
    }

    private async Task DownloadSvg()
    {
        if (svgText is null || svgUrl is null) return;
        string filename = Path.GetFileNameWithoutExtension(sourceName) + ".svg";
        await Js.InvokeVoidAsync("vecto.downloadUrl", svgUrl, filename);
    }

    private async Task ClearUrl(bool input)
    {
        var url = input ? inputUrl : svgUrl;
        if (!string.IsNullOrEmpty(url))
        {
            await Js.InvokeVoidAsync("vecto.revoke", url);
            if (input) inputUrl = null; else svgUrl = null;
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await ClearUrl(true);
            await ClearUrl(false);
        }
        catch (JSDisconnectedException) { }
    }
}
